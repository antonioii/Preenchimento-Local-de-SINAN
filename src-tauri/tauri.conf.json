{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SINAN Local",
  "version": "0.1.0",
  "identifier": "br.local.sinan",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "title": "SINAN Local",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Gerador local de PDFs SINAN",
    "longDescription": "Aplicacao local para preenchimento e geracao de PDFs SINAN sem servidor."
  }
}
